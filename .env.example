# Public (safe to expose in the browser) — available on client + server
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional aliases (fallbacks supported):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret — NEVER prefix with NEXT_PUBLIC_
# Required for the public share page (/share/[key]) to read data via RLS bypass.
# For other server-side reads you may also set these (fallbacks are supported):
# SUPABASE_URL=your-project-url
# SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Habit Coach (LangChain agent) — powers the /api/chat streaming endpoint.
# Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your-openrouter-key
# Optional: override the coach model (any model id supported by OpenRouter).
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# Required to run `npm run db:setup` (creates tables/policies/bucket).
# Create one at https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=your-personal-access-token

# IMPORTANT — email verification links
# The signup flow passes emailRedirectTo=<origin>/auth/callback, so links use the
# domain the user signed up from (never localhost in production).
# In the Supabase dashboard also set:
#   Authentication > URL Configuration > Site URL  -> your production domain
#   And add your domain to "Redirect URLs" (e.g. https://yourdomain.com/auth/callback)
